# Copier en .env (jamais versionné).

# Empreinte du mot de passe de l'espace d'administration (/binome/admin). Absente =
# administration fermée. Seule l'empreinte est stockée (jamais le mot de passe) ; au moins
# 20 caractères aléatoires sur un serveur exposé. Générer la ligne avec (saisie sans écho) :
#   macOS (zsh) : read -rs "P?Mot de passe admin : "; echo; printf '%s\n' "$P" | docker run --rm -i binome:latest hash-password --admin; unset P
#   Linux (bash) : read -rs -p "Mot de passe admin : " P; echo; printf '%s\n' "$P" | docker run --rm -i binome:latest hash-password --admin; unset P
# Au plus 2 tentatives de connexion par minute, tous clients confondus.
# BINOME_ADMIN_PASSWORD_HASH=pbkdf2-sha256:600000:…

# Empreinte du mot de passe EXIGÉ pour supprimer des parties (seconde clé, distincte de
# l'accès admin). Absente = suppression de parties désactivée. Le mot de passe lui-même
# n'est jamais stocké ; générer la ligne avec (mot de passe tapé sans écho) :
#   macOS (zsh) : read -rs "P?Mot de passe de suppression : "; echo; printf '%s\n' "$P" | docker run --rm -i binome:latest hash-password; unset P
#   Linux (bash) : read -rs -p "Mot de passe de suppression : " P; echo; printf '%s\n' "$P" | docker run --rm -i binome:latest hash-password; unset P
# BINOME_DELETE_PASSWORD_HASH=pbkdf2-sha256:600000:…

# Préfixe public : /binome (défaut) ou / pour servir l'application à la racine du domaine.
# BINOME_PUBLIC_PREFIX=/binome

# Port publié sans HTTPS (docker-compose.yml seul).
# BINOME_PORT=8080

# Nom de domaine du VPS, pour docker-compose.https.yml.
# BINOME_DOMAIN=binome.exemple.fr
