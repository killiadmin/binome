# These 3 values must point at the host machine's LAN IP so that other
# devices on the same Wi-Fi can reach the backend/Reverb containers.
# Run `../scripts/update-lan-ip.sh` (or `../start.sh`) to fill them in
# automatically instead of editing them by hand.
VITE_API_URL=http://127.0.0.1:8001/api
VITE_BACKEND_URL=http://127.0.0.1:8001
VITE_REVERB_HOST=127.0.0.1

# Must match REVERB_APP_KEY / REVERB_PORT / REVERB_SCHEME in backend/.env
VITE_REVERB_APP_KEY=binome_key
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
