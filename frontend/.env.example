# Must match REVERB_APP_KEY in backend/.env
VITE_REVERB_APP_KEY=binome_key

# The browser only ever talks to the Vite dev server's own origin, under
# /binome/ (http://killiadmin.local:8095/binome/ through ../portail, or
# http://localhost:5173/binome/); it proxies /binome/api, /binome/broadcasting
# and the /binome/app
# WebSocket to the backend & Reverb containers. So the host's LAN IP is no
# longer needed here and switching Wi-Fi networks requires no change.
#
# Only override these when running the frontend WITHOUT Docker (npm run dev),
# where the "backend" / "reverb" service names don't resolve:
# VITE_PROXY_BACKEND=http://127.0.0.1:8001
# VITE_PROXY_REVERB=http://127.0.0.1:8080
